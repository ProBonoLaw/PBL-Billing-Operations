{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Billing Operations: Gateway (Azure Test)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build BillingOperations",
      "program": "${workspaceFolder}/src/BillingOperations/bin/Debug/net10.0/BillingOperations.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/BillingOperations",
      "env": {
        "ROLE": "gateway",
        "AZURE_TOKEN_CREDENTIALS": "AzureCliCredential",
        "APPSETTINGS_FILE": "${workspaceFolder}/.vscode/azure-test.appsettings.json",
        "ASPNETCORE_ENVIRONMENT": "Development",
        "DOTNET_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5080"
      },
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
